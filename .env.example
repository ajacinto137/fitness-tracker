# ─────────────────────────────────────────────────────────────────
# Fitness Tracker — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────

# ---- PostgreSQL (used by docker-compose to create the database container) ----
POSTGRES_USER=fitness
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=fitness_tracker
# Host port Postgres is exposed on (change if 5432 is already used on your machine)
POSTGRES_PORT=5433

# ---- Database connection string ----
# Used by Prisma CLI commands you run from your host machine (migrate dev, studio, etc).
# Inside Docker, docker-compose overrides this to point at the "db" service automatically,
# so this value should point at localhost using the port above.
DATABASE_URL=postgresql://fitness:change_me_to_a_strong_password@localhost:5433/fitness_tracker?schema=public

# ---- Auth (NextAuth / Auth.js) ----
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_generated_secret
# Public URL the app is served from. Update this when you deploy to production.
AUTH_URL=http://localhost:3000

# ---- App ----
# Host port the Next.js app is exposed on.
APP_PORT=3000
NODE_ENV=development
